<mxfile host="app.diagrams.net"><diagram id="arch" name="Arquitetura"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Arquitetura – Submissão de Lance em Leilão Concorrente (bid-service)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Spec 001 · Java 21 · Spring Boot 4 · Kafka (single writer) · PostgreSQL · WebSocket/STOMP" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="-50" width="900" height="50" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;(participante do leilão)&lt;br&gt;&lt;br&gt;1. POST /bids&lt;br&gt;(bid_id, auction_id, valor)&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;WebSocket STOMP /ws&lt;br&gt;• /user/queue/bid-results&lt;br&gt;• /topic/auctions/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="140" height="440" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;bid-service&lt;/b&gt; (aplicação Spring Boot única)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="30" width="1030" height="540" as="geometry"/></mxCell><mxCell id="rl" value="&lt;b&gt;RateLimitFilter&lt;/b&gt;&lt;br&gt;Bucket4j em memória&lt;br&gt;(429 se exceder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="210" y="80" width="140" height="70" as="geometry"/></mxCell><mxCell id="jwt" value="&lt;b&gt;JwtAuthFilter&lt;/b&gt;&lt;br&gt;JWT HS256 simulado&lt;br&gt;(401 sem token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="140" height="70" as="geometry"/></mxCell><mxCell id="ctl" value="&lt;b&gt;BidController&lt;/b&gt;&lt;br&gt;POST /bids → 202 Recebido&lt;br&gt;+ RiskTierResolver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="550" y="80" width="160" height="70" as="geometry"/></mxCell><mxCell id="pipe" value="&lt;b&gt;BidPipeline&lt;/b&gt;&lt;br&gt;KafkaBidPipeline&lt;br&gt;(risk_tier no header)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750" y="80" width="150" height="70" as="geometry"/></mxCell><mxCell id="lst" value="&lt;b&gt;BidListener&lt;/b&gt;&lt;br&gt;group bid-processors&lt;br&gt;1 consumer/partição&lt;br&gt;ack manual pós-commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750" y="230" width="160" height="80" as="geometry"/></mxCell><mxCell id="tx" value="&lt;b&gt;BidTransactionService&lt;/b&gt;&lt;br&gt;@Transactional&lt;br&gt;idempotência por bid_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="230" width="160" height="80" as="geometry"/></mxCell><mxCell id="proc" value="&lt;b&gt;BidProcessor&lt;/b&gt;&lt;br&gt;regras puras: valor, starting_price, vendedor/líder, end_time (LogAppendTime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="530" y="350" width="200" height="90" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b&gt;AuctionRepository&lt;/b&gt;&lt;br&gt;UPDATE ... WHERE version=?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="170" height="60" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;BidRepository&lt;/b&gt;&lt;br&gt;INSERT append-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="170" height="60" as="geometry"/></mxCell><mxCell id="rn" value="&lt;b&gt;ResultNotifier&lt;/b&gt;&lt;br&gt;resultado ao autor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="780" y="370" width="150" height="60" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;LeaderBroadcaster&lt;/b&gt;&lt;br&gt;novo líder (broadcast)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="370" width="150" height="60" as="geometry"/></mxCell><mxCell id="ws" value="&lt;b&gt;WebSocketConfig&lt;/b&gt;&lt;br&gt;STOMP /ws · SimpleBroker /topic, /queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="280" height="50" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;Observabilidade&lt;/b&gt;: BidLogger (log JSON: auction_id, bid_id, user_id, decision, sequence) · BidMetrics (Micrometer → /actuator/prometheus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="210" y="480" width="520" height="60" as="geometry"/></mxCell><mxCell id="kafka" value="&lt;b&gt;Apache Kafka 3.9 (KRaft)&lt;/b&gt;&lt;br&gt;tópico &lt;b&gt;bids&lt;/b&gt; · 6 partições&lt;br&gt;key = auction_id&lt;br&gt;LogAppendTime · acks=all · idempotent" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1290" y="60" width="230" height="120" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;auctions (version, lock otimista)&lt;br&gt;bids (PK bid_id, trigger bloqueia UPDATE/DELETE)&lt;br&gt;Flyway V1, V2" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="630" width="330" height="90" as="geometry"/></mxCell><mxCell id="prom" value="Prometheus / agregador de logs&lt;br&gt;(consumo externo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="630" width="220" height="60" as="geometry"/></mxCell><mxCell id="dc" value="&lt;b&gt;Docker Compose&lt;/b&gt;: app · kafka · kafka-init (cria tópico) · postgres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1290" y="630" width="330" height="40" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Linha cheia: fluxo síncrono (HTTP)&lt;br&gt;Tracejada: fluxo assíncrono / eventos&lt;br&gt;Azul: pipeline · Amarelo: gateway (simulado) · Verde: domínio/persistência · Roxo: tempo real · Vermelho: observabilidade" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1290" y="230" width="330" height="100" as="geometry"/></mxCell><mxCell id="e1" value="1. POST /bids" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.1;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="rl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="rl" target="jwt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="jwt" target="ctl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="ctl" target="pipe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="2. produce (key=auction_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;entryDx=0;entryDy=15;" edge="1" parent="1" source="pipe" target="kafka"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="115"/><mxPoint x="1250" y="105"/></Array></mxGeometry></mxCell><mxCell id="e5b" value="202 Recebido (bid_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctl" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="55"/><mxPoint x="90" y="55"/></Array></mxGeometry></mxCell><mxCell id="e6" value="3. poll (ordem de offset)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="kafka" target="lst"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="270"/></Array></mxGeometry></mxCell><mxCell id="e7" value="4. processa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="lst" target="tx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="regras" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tx" target="proc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="5. grava estado (version+1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="tx" target="ar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="5. grava histórico" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="tx" target="br"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="360"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.3;exitY=1;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ar" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="330"/><mxPoint x="380" y="600"/><mxPoint x="430" y="600"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="br" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="420"/><mxPoint x="415" y="600"/><mxPoint x="560" y="600"/></Array></mxGeometry></mxCell><mxCell id="e13" value="6. após commit: ack + notifica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lst" target="rn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="se aceito" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="lst" target="lb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="270"/></Array></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="rn" target="ws"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="lb" target="ws"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="7. resultado ao autor + broadcast do novo líder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="ws" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="600"/><mxPoint x="90" y="600"/></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="obs" target="prom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="600"/><mxPoint x="470" y="660"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>